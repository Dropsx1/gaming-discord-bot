# ===== Required =====
DISCORD_TOKEN=your_bot_token_here

# That's all you need. Invite the bot to a server and run /setup there: it creates/reuses
# every channel and role and saves their IDs. Moving servers = invite the bot + run /setup.
#
# Everything below is OPTIONAL. Channel/role IDs here are overrides for the "home" server
# only; IDs saved by /setup always win.

# Empty (recommended) = slash commands sync instantly to every server the bot is in.
# Set to one server ID to limit the bot's slash commands (and env-var IDs) to that server.
GUILD_ID=

# ===== Optional core =====
COMMAND_PREFIX=!
SYNC_COMMANDS=true
LOG_LEVEL=INFO

# ===== Storage =====
# Railway: attach a volume mounted at /data and the database goes there automatically
# (or set DB_PATH=/data/bot.db explicitly). Locally it defaults to ./data/bot.db
DB_PATH=

# ===== Channels (optional: /setup fills these in per server) =====
WELCOME_CHANNEL_ID=
START_HERE_CHANNEL_ID=
SELF_ROLES_CHANNEL_ID=
LFG_CHANNEL_ID=
EVENT_CHANNEL_ID=
# Staff log channel (mod actions + tickets fall back to this)
LOG_CHANNEL_ID=
# Optional separate log channels
MOD_LOG_CHANNEL_ID=
TICKET_LOG_CHANNEL_ID=

# ===== Roles (optional: /setup creates Staff, Member, Prompt King, Remix Champion, LFG) =====
STAFF_ROLE_ID=
LFG_ROLE_ID=
# Member role granted by the rules "I accept" button (/rulespanel)
MEMBER_ROLE_ID=
# Also give it automatically on join? Keep false when the rules button is your gate.
MEMBER_ROLE_ON_JOIN=false
# Create missing self-roles automatically (true/false)
SELF_ROLES_AUTO_CREATE=true

# ===== Tickets =====
# optional: /setup creates the Tickets category
TICKET_CATEGORY_ID=
TICKET_TRANSCRIPT_LIMIT=500
TICKET_DM_TRANSCRIPT=false

# ===== Auto voice (Join to Create) =====
JOIN_TO_CREATE_CHANNEL_ID=
# Category for temp channels (defaults to the Join-to-Create channel's category)
VOICE_CATEGORY_ID=
VC_NAME_TEMPLATE=🎮 {user}'s Room
VC_DEFAULT_LIMIT=0

# ===== Events =====
# Ping everyone marked Going this many minutes before an /event starts
EVENT_REMINDER_MINUTES=30

# ===== Scheduled content (see cogs/schedule.py; content lives in data/) =====
SCHEDULE_ENABLED=true
TIMEZONE=America/New_York
# Prompt of the Day (daily 6:07 PM) + Prompt King (daily 6:05 PM, role for 24h)
PROMPT_CHANNEL_ID=
# Ping roles: if left empty, the self-roles named "Prompt pings" / "Challenges" are used
PROMPT_PING_ROLE_ID=
PROMPT_KING_ROLE_ID=
# Weekly digest (Mondays 10:13 AM): RSS headlines from data/rss_feeds.json
DIGEST_CHANNEL_ID=
# Remix Friday (Fri 4:11 PM kickoff, Sun 5:09 PM reminder, Sun 6:00 PM winner, role for 7 days)
CHALLENGE_CHANNEL_ID=
CHALLENGE_PING_ROLE_ID=
REMIX_CHAMPION_ROLE_ID=
# Live AI news (/news). Usually set with /setup-link NEWS_CHANNEL_ID instead.
NEWS_CHANNEL_ID=
# Breaking-news ping role; empty = a role named "AI News", if there is one
NEWS_ROLE_ID=
# Limits (defaults shown): poll every 20 min, 1 post per 30 min, 12/day, quiet 1-7 AM, 9+/10 = breaking
# NEWS_POLL_MINUTES=20  NEWS_MIN_GAP_MINUTES=30  NEWS_DAILY_LIMIT=12  NEWS_QUIET_START=1  NEWS_QUIET_END=7
# NEWS_BREAKING_SCORE=9  NEWS_BREAKING_DAILY_LIMIT=3
# Local hour for the optional daily AI recap (/news daily on)
# NEWS_DAILY_RECAP_HOUR=18

# ===== AI (Grok / xAI) =====
# Key from https://console.x.ai. Leave empty to turn every AI feature off
# (/idea and /prompt then use built-in lists; /ask, /imagine and AI automod reply "AI is off").
XAI_API_KEY=
# Model for /idea and /prompt. If unset/wrong, the bot logs the available ones at startup.
XAI_MODEL=
# Cheap text model for /ask, AI auto-moderation and /imagine safety checks.
# Empty = use XAI_MODEL. Pick a "non-reasoning" model from the startup log's list to keep costs low.
XAI_FAST_MODEL=
# Strongest chat model, for /ask, @mention chat, /summarize, ticket summaries and news recaps
XAI_SMART_MODEL=grok-4.7
# Reasoning effort for the smart model (low|medium|high|xhigh; empty = model default "high")
XAI_SMART_REASONING=low
# Vision model for automod image checks (empty = XAI_SMART_MODEL)
XAI_VISION_MODEL=
# Image model for /imagine
XAI_IMAGE_MODEL=grok-imagine-image
# Per-feature daily spend caps in USD (whole bot), e.g. ask=2,imagine=2,summarize=1 (empty = built-in defaults)
AI_DAILY_COST_CAPS=
# Daily limits (reset at midnight in TIMEZONE)
ASK_DAILY_LIMIT=30
IMAGINE_DAILY_LIMIT=5
SUMMARIZE_DAILY_LIMIT=10
TRIVIA_DAILY_LIMIT=20
# /ask memory: exchanges remembered per channel/thread, and for how long
ASK_MEMORY_TURNS=6
ASK_MEMORY_HOURS=24
# AI-personalized welcome line (template is used when AI is off/fails)
WELCOME_AI=true
# Images per day for the whole server (an admin can override per server with /imagine-cap)
IMAGINE_GUILD_DAILY_CAP=50
# Advanced (optional): XAI_API_BASE=https://api.x.ai/v1  XAI_MAX_TOKENS=300
